{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Trusted_Connection=true;Database=AtelierDB;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Atelier.Api",
    "Audience": "Atelier.Frontend",
    "ExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 14
  },
  "Auth": {
    "RequestsPerMinute": 10
  }
}